# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:123456@localhost:5432/ailibrary

# ── JWT Authentication ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── File Storage (MinIO) ────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ── Redis Cache ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=false

# ── Server ───────────────────────────────────────────────────
PORT=3000
ALLOWED_HOSTS=*

# ── Seed (optional) ─────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@example.edu
# SEED_ADMIN_PASSWORD=Admin123!

# ── AI Service ───────────────────────────────────────────────
# Backend chỉ là HTTP client gọi sang ai_service (Python/FastAPI).
# Cấu hình Ollama (base URL, model qwen3:4b, embed model, ChromaDB path)
# nằm trong ai_service/.env — KHÔNG cấu hình Ollama ở file này.
AI_SERVICE_URL=http://localhost:8000

# Các biến dưới đây CHƯA được code nào đọc (dự phòng cho tính năng AI sau này):
AI_RATE_LIMIT_STUDENT=10
AI_RATE_LIMIT_LECTURER=20
AI_RATE_LIMIT_ADMIN=0
AI_MAX_MESSAGE_LENGTH=2000
AI_SYSTEM_PROMPT="Bạn là trợ lý AI học thuật của Thư viện số. Trả lời chính xác bằng tiếng Việt, CHỈ dựa trên nội dung tài liệu được cung cấp trong CONTEXT. Nếu CONTEXT không đủ thông tin, hãy nói rõ. KHÔNG bịa thông tin. Luôn trích dẫn nguồn tài liệu."
