# Backend NestJS API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Frontend Mock API Mode (MSW v2)
# Set to 'true' to enable local MSW Mock API without backend
NEXT_PUBLIC_USE_MOCK_API=false

# Mock User Role: STUDENT | LECTURER | CONTENT_MANAGER | ADMIN
NEXT_PUBLIC_MOCK_ROLE=STUDENT

